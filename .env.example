# MongoDB Atlas Connection URI
MONGODB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority

# MongoDB Database Name
MONGODB_DB_NAME=license-ei

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_super_secret_key_change_in_production

# Optional: RSA 2048-bit Private Key for serverless deployments (Vercel)
# If omitted, it will automatically load from keys/private.pem
# RSA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
